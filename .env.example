# Frontend build-time env. Vite reads VITE_* variables and bakes them in at build.
# Copy to .env.development (dev) or .env.production (prod build).

# In local dev with `npm run dev`, the Vite proxy handles /api -> :8000,
# so leave VITE_API_BASE_URL empty.
VITE_API_BASE_URL=

# Optional bearer token sent on every request. Only set this in builds where
# the backend has API_TOKEN configured.
VITE_API_TOKEN=
